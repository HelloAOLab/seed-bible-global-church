  "chapter": {
    "number": 23,
    "content": [
      { "type": "hebrew_subtitle", "content": ["A Psalm by David."] },
      {
        "type": "verse",
        "number": 1,
        "content": [
          { "text": "The LORD is my shepherd;", "poem": 1 },
          { "text": "I shall lack nothing.", "poem": 2 }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          { "text": "He makes me lie down in green pastures.", "poem": 1 },
          { "text": "He leads me beside still waters.", "poem": 2 }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          { "text": "He restores my soul.", "poem": 1 },
          {
            "text": "He guides me in the paths of righteousness for his name’s sake.",
            "poem": 2
          }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          {
            "text": "Even though I walk through the valley of the shadow of death,",
            "poem": 1
          },
          { "text": "I will fear no evil, for you are with me.", "poem": 2 },
          { "text": "Your rod and your staff,", "poem": 1 },
          { "text": "they comfort me.", "poem": 2 }
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          { "text": "You prepare a table before me", "poem": 1 },
          { "text": "in the presence of my enemies.", "poem": 2 },
          { "text": "You anoint my head with oil.", "poem": 1 },
          { "text": "My cup runs over.", "poem": 2 }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          {
            "text": "Surely goodness and loving kindness shall follow me all the days of my life,",
            "poem": 1
          },
          { "text": "and I will dwell in the LORD’s house forever.", "poem": 2 }
        ]
      }
    ],
    "footnotes": []
  },
